{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoraFlux",
  "version": "1.4.0",
  "identifier": "pl.cybersora.soraconverter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "SoraFlux",
        "width": 1180,
        "height": 800,
        "minWidth": 860,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "category": "Video",
    "shortDescription": "Lokalny konwerter wideo, audio, obrazów i GIF z pobieraniem",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "languages": [
          "Polish",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "./nsis/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4QTJFRTg0QUMxNjg3NjkKUldScGh4YXNoTzZpZUg0Z042K3FTYjRWZ2ZPMzNidU9uK3NRS3dxbFplT3RTOU5mRUhhRENhVnMK",
      "endpoints": [
        "https://github.com/cybersora9/soraflux/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
